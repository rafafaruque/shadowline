{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": { "@benchmark/*": ["./src/*"] }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "hidden-tests/**/*.ts",
    "vitest*.ts"
  ]
}
