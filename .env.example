# Server-only. Use a Gemini Developer API project on the free tier.
GEMINI_API_KEY=
SHADOWLINE_MODEL=gemini-3.7-flash

# Codex CLI is an alternate provider using local `codex login` credentials.
# No API key is required. Model selection is server-side and independent of Gemini.
SHADOWLINE_CODEX_MODEL=gpt-6-astra
# Optional absolute path if codex is not on the server's PATH:
# SHADOWLINE_CODEX_BIN=/absolute/path/to/codex

# Optional explicit USD / million token estimates; leave unset for unknown cost.
# Set all three to 0 only if you have confirmed your project is on the free tier.
# SHADOWLINE_INPUT_USD_PER_MILLION=0
# SHADOWLINE_CACHED_INPUT_USD_PER_MILLION=0
# SHADOWLINE_OUTPUT_USD_PER_MILLION=0
